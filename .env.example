# ============================================
# AutoLeadGen 海外客 - 环境配置文件
# 复制此文件为 .env 并填写真实值
# cp .env.example .env
# ============================================

# 数据库配置 (必填 - MySQL/MariaDB)
DATABASE_URL=mysql+pymysql://username:password@your-db-host:3306/your_db_name?charset=utf8mb4

# AI 模型配置 (必填 - MiniMax API)
MINIMAX_API_KEY=your_minimax_api_key_here

# Snov.io 配置 (必填 - 邮箱挖掘 API)
SNOVIO_CLIENT_ID=your_snovio_client_id_here
SNOVIO_CLIENT_SECRET=your_snovio_client_secret_here

# 搜索引擎 API (推荐 - 防封锁)
# 国产优先: https://bochaai.com/
BOCHA_API_KEY=your_bocha_api_key_here
BOCHA_SEARCH_FRESHNESS=noLimit
BOCHA_SEARCH_SUMMARY=false

# 免费注册: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Apollo 搜索/邮箱补全 API (可选)
APOLLO_API_KEY=

# Unipile 全渠道连接 (可选)
UNIPILE_DSN=https://api3.unipile.com:13300
UNIPILE_API_KEY=

# 前端 API 地址 (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
FRONTEND_BASE_URL=http://localhost:3000

# 后台任务
# ENABLE_BACKGROUND_WORKERS=true 会启动完整外呼循环：搜客户、写草稿、发邮件、查回复
# ENABLE_BACKGROUND_WORKERS=false 且 ENABLE_PROSPECTING_WORKER=true 时，只持续搜客户，不自动发邮件
ENABLE_BACKGROUND_WORKERS=false
ENABLE_PROSPECTING_WORKER=true
PROSPECTING_LOOP_INTERVAL_SECONDS=90
ENABLE_INBOX_MONITOR_WORKER=true
INBOX_MONITOR_INTERVAL_SECONDS=300

# 商业化积分制
CREDITS_ENABLED=true
CREDITS_DEFAULT_BALANCE=100
CREDITS_COST_AI_EMAIL_DRAFT=2
CREDITS_COST_AI_REPLY_DRAFT=2
CREDITS_COST_EMAIL_SEND=1
CREDITS_COST_LINKEDIN_INVITE=2
CREDITS_COST_WHATSAPP_MESSAGE=2

# 搜客户数量与稳定性
SEARCH_PIPELINE_TARGET=50
SEARCH_WORKFLOW_EMAIL_TARGET=200
SEARCH_WORKFLOW_TOTAL_TARGET=250
ENABLE_WORKFLOW_SEARCH_STAGE=true
SEARCH_WORKFLOW_COOLDOWN_SECONDS=600
SEARCH_BATCH_LEAD_LIMIT=10
SEARCH_MAX_DOMAINS_PER_BATCH=40
SEARCH_LEADS_PER_DOMAIN=5
SEARCH_SAVE_COMPANIES_WITHOUT_EMAIL=true
SEARCH_REQUIRE_EMAIL_DOMAIN_MATCH=true
SEARCH_DIRECT_PROVIDER=
SNOVIO_SKIP_DOMAINS_WITHOUT_EMAILS=true
SEARCH_BUYER_INTENT_MODE=true
TAVILY_QUERIES_PER_BATCH=4
TAVILY_REGIONS_PER_BATCH=2
TAVILY_DISABLE_ON_USAGE_LIMIT=true
TAVILY_USAGE_LIMIT_COOLDOWN_SECONDS=3600
LINKEDIN_PROVIDER_LIMIT_COOLDOWN_SECONDS=3600
SNOVIO_DOMAIN_SEARCH_PAGES=3
SNOVIO_ALLOW_BROAD_ROLE_FALLBACK=false
SNOVIO_ENABLE_MOCK_FALLBACK=false
SNOVIO_POLL_ATTEMPTS=8
SNOVIO_POLL_INTERVAL_SECONDS=2
SNOVIO_ALLOW_VERIFIED_DOMAIN_EMAIL_FALLBACK=true
SNOVIO_DOMAIN_EMAIL_FALLBACK_LIMIT=2
SNOVIO_RUN_CREDIT_TESTS=false
ENABLE_KEYWORD_AUTO_MUTATION=true

# 发信保护：避免把坏邮箱继续发出去
EMAIL_MAX_DAILY_PER_ACCOUNT=30
EMAIL_SKIP_GENERATED_MOCK_EMAILS=true
EMAIL_CHECK_RECIPIENT_DOMAIN_DNS=true
EMAIL_BOUNCE_RATE_PAUSE_THRESHOLD=0.08
EMAIL_MIN_SENT_FOR_BOUNCE_PAUSE=20

# 质量门槛：只发给高匹配度线索（fit_score >= 此值才发，默认关闭 = 广撒网模式）
EMAIL_MIN_FIT_SCORE=60
EMAIL_REQUIRE_MIN_FIT_SCORE=false
# 只发给已验证邮箱的线索（email_validation_status 必须是 valid 或 catch-all）
EMAIL_REQUIRE_VERIFIED=true
