# ============================================
# AutoLeadGen 海外客 - 环境配置文件
# 复制此文件为 .env 并填写真实值
# cp .env.example .env
# ============================================

# 数据库配置 (必填 - MySQL/MariaDB)
DATABASE_URL=mysql+pymysql://username:password@your-db-host:3306/your_db_name?charset=utf8mb4
# In containers, prefer DATABASE_URL_FILE=/run/secrets/database_url and leave
# DATABASE_URL unset. Every supported secret also accepts a NAME_FILE variant.

# Product V2 本地隔离安全开关（默认不允许真实外部调用）
AUTOLEADGEN_ENV=local
AUTOLEADGEN_CONNECTOR_MODE=fake
ALLOW_REAL_EXTERNAL_CALLS=false
# Separate paid-search/email-verification approval. Keep false for the
# production Email-only release; CSV staging remains available.
ALLOW_REAL_ACQUISITION_CALLS=false
ACQUISITION_HARD_PAUSE=true
ACQUISITION_OWNER_ALLOWLIST=
ACQUISITION_APPROVAL_ID=
ACQUISITION_DAILY_SEARCH_LIMIT=5
ACQUISITION_DAILY_VERIFICATION_LIMIT=20
ACQUISITION_PRICE_VERSION=replace-with-approved-price-version
LINKEDIN_HARD_PAUSE=true
LINKEDIN_OWNER_ALLOWLIST=
LINKEDIN_APPROVAL_ID=
LINKEDIN_DAILY_ACCOUNT_LIMIT=5
LINKEDIN_PRICE_VERSION=replace-with-approved-price-version
WHATSAPP_HARD_PAUSE=true
WHATSAPP_OWNER_ALLOWLIST=
WHATSAPP_APPROVAL_ID=
WHATSAPP_DAILY_ACCOUNT_LIMIT=5
WHATSAPP_PRICE_VERSION=replace-with-approved-price-version
PRODUCT_V2_LEGACY_READ_ONLY=true
# Leave PRODUCT_V2_OWNER_PATH_ENFORCEMENT unset: code defaults it off only for
# local/test and on for production-like environments. An explicit override is
# reserved for a reviewed deployment change.
PRODUCT_V2_LEGACY_WRITERS_FROZEN=false
# R3 legacy-write recovery is a separate incident approval; read fallback does
# not require or imply enabling this flag.
PRODUCT_V2_LEGACY_WRITE_RECOVERY_APPROVED=false
PRODUCT_V2_OWNER_FENCE_TIMEOUT_SECONDS=10
OUTBOUND_HARD_PAUSE=1
# Backfill stays disabled until a command explicitly targets an isolated copy.
PRODUCT_V2_ISOLATED_DATABASE=false
PRODUCT_V2_BACKFILL_APPLY=false

# Product V2 Provider webhook authentication. Keep secrets empty in files;
# inject a >=32-byte value from the approved runtime secret store. Resolution
# may be global, per Provider, or per owner+Provider (most specific wins).
PRODUCT_V2_WEBHOOK_SECRET=
# Example names only: PRODUCT_V2_WEBHOOK_SECRET_FAKE_EMAIL and
# PRODUCT_V2_WEBHOOK_SECRET_OWNER_1_FAKE_EMAIL
PRODUCT_V2_WEBHOOK_TOLERANCE_SECONDS=300
# Exact raw request bytes are rejected before HMAC/JSON processing above 1 MiB.
PRODUCT_V2_WEBHOOK_MAX_BODY_BYTES=1048576
# Production defaults to rejecting webhook traffic until this is explicitly
# set false after the endpoint and signing secret have passed staging replay.
PRODUCT_V2_WEBHOOK_REJECT_ALL=true

# Authentication and stored SMTP credential encryption (required and separate
# in staging/production; inject through *_FILE in deployed containers).
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720
SMTP_ENCRYPTION_KEY=
UNSUBSCRIBE_TOKEN_SECRET=
SMTP_TIMEOUT_SECONDS=20
IMAP_TIMEOUT_SECONDS=20
IMAP_LOOKBACK_DAYS=7
IMAP_MAX_MESSAGES_PER_ACCOUNT=200
IMAP_MAX_MESSAGE_BYTES=5242880

# Production request and artifact identity gates.
CORS_ORIGINS=
ALLOWED_HOSTS=
RELEASE_SHA=
IMAGE_DIGEST=
PRODUCTION_CHANGE_ID=

# AI 模型配置 (必填 - MiniMax API)
MINIMAX_API_KEY=your_minimax_api_key_here

# Snov.io 配置（可选；默认停用，本轮使用 LeadContact）
SNOVIO_ENABLED=false
SNOVIO_CLIENT_ID=your_snovio_client_id_here
SNOVIO_CLIENT_SECRET=your_snovio_client_secret_here

# 搜索引擎 API (推荐 - 防封锁)
# 国产优先: https://bochaai.com/
BOCHA_API_KEY=your_bocha_api_key_here
BOCHA_SEARCH_FRESHNESS=noLimit
BOCHA_SEARCH_SUMMARY=false

# 免费注册: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Apollo 搜索/邮箱补全 API (可选)
APOLLO_API_KEY=

# Unipile 全渠道连接 (可选)
UNIPILE_DSN=https://api3.unipile.com:13300
UNIPILE_API_KEY=

# 前端 API 地址 (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
FRONTEND_BASE_URL=http://localhost:3000

# Legacy 后台任务开关（Product V2 API 不再在进程内启动线程）
# V2 请用 `python -m product_v2.worker <worker_type>` 启动独立 worker。
ENABLE_BACKGROUND_WORKERS=false
ENABLE_PROSPECTING_WORKER=false
PROSPECTING_LOOP_INTERVAL_SECONDS=90
ENABLE_INBOX_MONITOR_WORKER=false
INBOX_MONITOR_INTERVAL_SECONDS=300

# 商业化积分制
CREDITS_ENABLED=true
CREDITS_DEFAULT_BALANCE=100
CREDITS_COST_AI_EMAIL_DRAFT=2
CREDITS_COST_AI_REPLY_DRAFT=2
CREDITS_COST_EMAIL_SEND=1
CREDITS_COST_LINKEDIN_INVITE=2
CREDITS_COST_WHATSAPP_MESSAGE=2

# 搜客户数量与稳定性
SEARCH_PIPELINE_TARGET=50
SEARCH_WORKFLOW_EMAIL_TARGET=200
SEARCH_WORKFLOW_TOTAL_TARGET=250
ENABLE_WORKFLOW_SEARCH_STAGE=true
SEARCH_WORKFLOW_COOLDOWN_SECONDS=3600
SEARCH_BATCH_LEAD_LIMIT=3
SEARCH_MAX_DOMAINS_PER_BATCH=10
SEARCH_LEADS_PER_DOMAIN=5
SEARCH_SAVE_COMPANIES_WITHOUT_EMAIL=false
SEARCH_REQUIRE_EMAIL_DOMAIN_MATCH=true
SEARCH_DIRECT_PROVIDER=
SNOVIO_SKIP_DOMAINS_WITHOUT_EMAILS=true
SEARCH_MULTI_SOURCE_MODE=false
SEARCH_BUYER_INTENT_MODE=true
TAVILY_QUERIES_PER_BATCH=4
TAVILY_REGIONS_PER_BATCH=2
TAVILY_DISABLE_ON_USAGE_LIMIT=true
TAVILY_USAGE_LIMIT_COOLDOWN_SECONDS=3600
LINKEDIN_PROVIDER_LIMIT_COOLDOWN_SECONDS=3600
SNOVIO_DOMAIN_SEARCH_PAGES=3
SNOVIO_ALLOW_BROAD_ROLE_FALLBACK=false
SNOVIO_ENABLE_MOCK_FALLBACK=false
SNOVIO_POLL_ATTEMPTS=8
SNOVIO_POLL_INTERVAL_SECONDS=2
SNOVIO_ALLOW_VERIFIED_DOMAIN_EMAIL_FALLBACK=false
SNOVIO_DOMAIN_EMAIL_FALLBACK_LIMIT=2
SNOVIO_USAGE_AUDIT_ENABLED=true
SNOVIO_RUN_CREDIT_TESTS=false
ENABLE_KEYWORD_AUTO_MUTATION=true

# 发信保护：避免把坏邮箱继续发出去
EMAIL_MAX_DAILY_PER_ACCOUNT=30
EMAIL_SKIP_GENERATED_MOCK_EMAILS=true
EMAIL_CHECK_RECIPIENT_DOMAIN_DNS=true
EMAIL_BOUNCE_RATE_PAUSE_THRESHOLD=0.08
EMAIL_MIN_SENT_FOR_BOUNCE_PAUSE=20

# 质量门槛：只发给高匹配度线索（fit_score >= 此值才发，默认关闭 = 广撒网模式）
EMAIL_MIN_FIT_SCORE=60
EMAIL_REQUIRE_MIN_FIT_SCORE=false
# 只发给已验证邮箱的线索（email_validation_status 必须是 valid 或 catch-all）
EMAIL_REQUIRE_VERIFIED=true
EMAIL_REQUIRE_VALID_RESEARCH=true
EMAIL_REQUIRE_RECIPIENT_TIMEZONE=true
EMAIL_FOLLOWUP_USE_BUSINESS_DAYS=true
LEADCONTACT_MAX_CONTACTS_PER_COMPANY=2
