# Non-secret deployment metadata. Copy outside the repository before use.
AUTOLEADGEN_ENV=production
APP_DOMAIN=app.example.com
CORS_ORIGINS=https://app.example.com
ALLOWED_HOSTS=app.example.com
RELEASE_SHA=replace-with-reviewed-git-sha
PRODUCTION_CHANGE_ID=CHG-0000

# Immutable images emitted by the release workflow.
BACKEND_IMAGE=ghcr.io/your-org/autoleadgen-api
BACKEND_IMAGE_DIGEST=sha256:replace
FRONTEND_IMAGE=ghcr.io/your-org/autoleadgen-frontend
FRONTEND_IMAGE_DIGEST=sha256:replace

# Secret files are provisioned by the host secret manager, mode 0400.
DATABASE_URL_SECRET_PATH=/secure/autoleadgen/database_url
JWT_SECRET_PATH=/secure/autoleadgen/jwt_secret
SMTP_ENCRYPTION_KEY_SECRET_PATH=/secure/autoleadgen/smtp_encryption_key
UNSUBSCRIBE_TOKEN_SECRET_PATH=/secure/autoleadgen/unsubscribe_token_secret
WEBHOOK_SECRET_PATH=/secure/autoleadgen/product_v2_webhook_secret
RUNTIME_CONTROL_DIR=/secure/autoleadgen/runtime-control
BACKFILL_EVIDENCE_DIR=/secure/autoleadgen/backfill-evidence
PRODUCT_V2_APPROVED_DATABASE_FINGERPRINT=replace-with-reviewed-sha256
PRODUCT_V2_PRODUCTION_MIGRATION_APPROVED=false
# Required in addition to migration approval only for a verified legacy database
# that has no alembic_version row yet.
PRODUCT_V2_LEGACY_BASELINE_STAMP_APPROVED=false
PRODUCT_V2_PRODUCTION_BACKFILL_APPROVED=false

# Automatic SMTP remains independently disabled after the reviewed canary.
# A separate approved change must set the flag, the exact active V2 Owner IDs,
# and a deployment-wide per-account ceiling no greater than 100.
PRODUCT_V2_PRODUCTION_AUTO_SEND_APPROVED=false
PRODUCT_V2_AUTO_SEND_APPROVAL_ID=
PRODUCT_V2_AUTO_SEND_OWNER_IDS=
PRODUCT_V2_AUTO_SEND_MAX_DAILY_PER_ACCOUNT=20

# Non-secret immutable evidence references. These point to restricted records;
# they must never contain credentials, PII, message bodies, or database URLs.
PRODUCT_V2_BACKUP_RESTORE_EVIDENCE_ID=replace-with-restore-test-id
PRODUCT_V2_MONITORING_EVIDENCE_ID=replace-with-alert-route-test-id
PRODUCT_V2_STAGING_ACCEPTANCE_EVIDENCE_ID=replace-with-staging-run-id
PRODUCT_V2_EMAIL_DNS_EVIDENCE_ID=replace-before-enable-real
PRODUCT_V2_COMPLIANCE_APPROVAL_ID=replace-before-enable-real
PRODUCT_V2_SHADOW_EVIDENCE_ID=replace-before-enable-real

# Start deploys paused. A reviewed enable-real change first sets the external
# approval true and recreates the workers while the live outbound control file
# remains true. Release that file only after enable-real preflight passes.
AUTOLEADGEN_CONNECTOR_MODE=real
ALLOW_REAL_EXTERNAL_CALLS=false
# Real prospecting is outside the approved Email-only launch scope.
ALLOW_REAL_ACQUISITION_CALLS=false
ACQUISITION_OWNER_ALLOWLIST=
ACQUISITION_APPROVAL_ID=
ACQUISITION_DAILY_SEARCH_LIMIT=5
ACQUISITION_DAILY_VERIFICATION_LIMIT=20
ACQUISITION_PRICE_VERSION=
LINKEDIN_OWNER_ALLOWLIST=
LINKEDIN_APPROVAL_ID=
LINKEDIN_DAILY_ACCOUNT_LIMIT=5
LINKEDIN_PRICE_VERSION=
WHATSAPP_OWNER_ALLOWLIST=
WHATSAPP_APPROVAL_ID=
WHATSAPP_DAILY_ACCOUNT_LIMIT=5
WHATSAPP_PRICE_VERSION=
# Set true only for the approval-bound, no-send SMTP/IMAP probe and worker phase.
EMAIL_ACCOUNT_PROBE_APPROVED=false
# Create runtime-control/outbound_hard_pause,
# runtime-control/acquisition_hard_pause, runtime-control/linkedin_hard_pause,
# runtime-control/whatsapp_hard_pause and runtime-control/webhook_reject_all
# with the single line: true
